{
  "name": "more-more-code",
  "version": "2.0.1",
  "description": "",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "start": "bun run packages/server/src/index.ts",
    "build:cli": "bun run --filter @more-more-code/cli build",
    "test:harness": "bun run --filter @more-more-code/harness test",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "cf:dev": "bunx wrangler dev --config workers/api-proxy/wrangler.jsonc",
    "cf:deploy": "bunx wrangler deploy --config workers/api-proxy/wrangler.jsonc",
    "cf:typecheck": "bunx tsc --noEmit -p workers/api-proxy/tsconfig.json"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
