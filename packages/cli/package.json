    "@ai-sdk/provider-utils": "^5.0.7",
    "@ai-sdk/react": "^4.0.40",
    "@more-more-code/harness": "workspace:*",
    "@more-more-code/runtime-store": "workspace:*",
    "@more-more-code/session-store": "workspace:*",
    "@more-more-code/shared": "workspace:*",
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "ai": "^7.0.37",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
