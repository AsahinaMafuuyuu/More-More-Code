{
    "name": "@more-more-code/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@clerk/backend": "^3.12.0",
        "@hono/zod-validator": "^0.8.0",
        "@more-more-code/database": "workspace:*",
        "@more-more-code/shared": "workspace:*",
        "@polar-sh/sdk": "^0.49.0",
        "@sentry/bun": "^10.65.0",
        "@sentry/hono": "^10.65.0",
        "dotenv": "^17.4.2",
        "hono": "^4.12.28",
        "open": "^8.0.0",
        "zod": "^4.4.3"
    }
}