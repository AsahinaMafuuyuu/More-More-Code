generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model RuntimeEvent {
  id        String   @id @default(cuid())
  sessionId String?
  type      String
  payload   Json
  createdAt DateTime @default(now())
  sequence  Int @unique

  @@index([sessionId])
  @@index([type])
}

model RuntimeSnapshot {
  id          String   @id @default(cuid())
  sessionId   String?
  eventOffset Int
  state       Json
  createdAt   DateTime @default(now())

  @@index([sessionId])
}
