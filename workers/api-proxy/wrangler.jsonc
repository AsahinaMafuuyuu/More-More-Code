{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "more-more-code-api-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.asahinamafuyu.top",
      "custom_domain": true
    }
  ],
  "vars": {
    "ORIGIN_HOST": "more-more-codeserver-production.up.railway.app"
  },
  "observability": {
    "enabled": true
  }
}
